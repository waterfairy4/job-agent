# Copy this file to .env and fill in your key.
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash          # or deepseek-v4-pro (stronger, pricier)

# Qwen instead:
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# Embeddings (local, free). Smaller English-only model for a quick first test:
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# Slow Hugging Face downloads on campus:
# HF_ENDPOINT=https://hf-mirror.com

# Optional: a stronger model only for writing the full CV (a few calls per CV)
# CV_MODEL=deepseek-v4-pro

# Web search for find_jobs and research_company.
# Baidu (百度搜索 via Qianfan 千帆): API key from console.bce.baidu.com (千帆 -> API Key), has a daily free quota
# SEARCH_PROVIDER=baidu
# SEARCH_API_KEY=bce-v3/...
# Bocha (博查) is built for China: key from open.bochaai.com
# SEARCH_PROVIDER=bocha
# SEARCH_API_KEY=your-bocha-key
# Or Tavily (free tier, may need a VPN from China):
# SEARCH_PROVIDER=tavily
# SEARCH_API_KEY=tvly-...

# Optional: which file in profile/ is your CV (otherwise a file named like cv/resume/简历)
# CV_FILE=Zeynep_Ilayda_Uzunoglu_CV_real.pdf
# Photo/logo: taken from your CV PDF automatically, or put photo.jpg / logo.png in profile/

# find_jobs searches only these job sites (comma separated; empty = the whole web)
# JOB_SITES=www.nowcoder.com,www.yingjiesheng.com,www.shixiseng.com,www.zhipin.com,www.liepin.com
# JOB_RECENCY=semiyear              # week / month / semiyear / year

# Conversations are saved here, so a restart continues where you stopped ("" = memory only)
# CHECKPOINT_DB=data/checkpoints.sqlite
# Network retries for web search and job pages: attempts per call, first wait in seconds (doubles)
# HTTP_RETRIES=3
# HTTP_BACKOFF=1.0
